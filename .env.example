# AICTE Complaint Monitoring Platform - Environment Configuration

# Database Configuration (Supabase PostgreSQL / Cloud Postgres)
# Replace with your actual Supabase connection string:
# Format: postgresql+psycopg2://postgres:<PASSWORD>@<HOST>:5432/postgres?sslmode=require
# Or for local SQLite development: sqlite:///./aicte_complaints.db
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Application Environment
ENVIRONMENT=development

# JWT Secret Key (Generate a random 32-character string for production)
SECRET_KEY=aicte-secret-key-change-in-production-use-a-strong-random-key

# JWT Expiration in minutes (Default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
